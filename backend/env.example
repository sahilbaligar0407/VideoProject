# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# File Storage Configuration
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# Video Processing Configuration
MAX_VIDEO_SIZE_MB=500
MAX_CLIP_DURATION=60
MIN_CLIP_DURATION=15

# Number of clips to generate
NUM_CLIPS=3

# OpenAI Whisper model
WHISPER_MODEL=whisper-1

# Clip length policy
MIN_CLIP_DURATION=15.0
TARGET_CLIP_DURATION=28.0
MAX_CLIP_DURATION=60.0

# Ending snap policy
SNAP_MAX_OVERHANG=4.0
SNAP_SILENCE_THRESH_DB=-35.0
SNAP_MIN_PAUSE=0.25
SNAP_PUNCTUATIONS=.!?;:

# Vertical render
VERTICAL_ASPECT=9:16
VERTICAL_WIDTH=1080
VERTICAL_HEIGHT=1920
VERTICAL_SAFE_TOP=160
VERTICAL_SAFE_BOTTOM=260
BG_BLUR=true

# Caption modes: "burn" | "sidecar" | "off"
CAPTION_MODE=sidecar

# Caption theme
CAPTION_FONT=Inter
CAPTION_FONTSIZE_VERTICAL=44
CAPTION_FONTSIZE_HORIZONTAL=36
CAPTION_OUTLINE=3
CAPTION_SHADOW=1
CAPTION_PRIMARY_HEX=#FFFFFF
CAPTION_OUTLINE_HEX=#000000
CAPTION_MARGIN_TOP=160
CAPTION_MARGIN_BOTTOM=260
CAPTION_H_MARGIN_BOTTOM=120
CAPTION_MAX_WIDTH_PCT=0.9

# Topic search
TOPIC_WINDOW_SEC=24.0
TOPIC_WINDOW_PADDING=2.0
TOPIC_MIN_SCORE=0.28

# Viral Similarity Engine Configuration
EMBEDDING_MODEL=text-embedding-3-small
VIRAL_WINDOW_SEC=16
VIRAL_WINDOW_HOP=8
VIRAL_MIN_SCORE=0.30
VIRAL_TOP_K=12
VIRAL_MAX_TERMS=256
EMBED_CACHE_DIR=./.embed_cache
